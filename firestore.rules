rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /checkins/{checkInId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /clients/{clientId} {
      allow read, write: if true;
    }
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /company_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
